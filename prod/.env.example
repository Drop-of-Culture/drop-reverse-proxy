# Copy to prod/.env and fill. docker compose reads it automatically.

# public site is ${DOMAIN}, back-office is admin.${DOMAIN}
DOMAIN=
ACME_EMAIL=

# must match db_password in prod/app.toml
POSTGRES_PASSWORD=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# GitHub OAuth App (org settings > Developer settings > OAuth Apps)
# callback URL: https://admin.<DOMAIN>/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_GITHUB_ORG=
# optional, restricts to one team of the org (team slug)
OAUTH2_PROXY_GITHUB_TEAM=
